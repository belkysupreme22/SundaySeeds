# Copy to .env.local and fill these only for the intended SundaySeeds dev project.
# All EXPO_PUBLIC values are visible in the client bundle. Never use a secret or
# service-role key here. Missing/invalid values leave connected accounts disabled.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Owned explicit-action landing pages, configured in the Supabase redirect
# allowlist and email templates. Use HTTPS; HTTP is allowed only for localhost.
# Leave blank until hosting and email confirmation/recovery are configured.
EXPO_PUBLIC_AUTH_CONFIRMATION_URL=
EXPO_PUBLIC_AUTH_RECOVERY_URL=
