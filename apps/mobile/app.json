{
  "expo": {
    "name": "SundaySeeds",
    "slug": "sundayseeds",
    "scheme": "sundayseeds",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chobor.sundayseeds"
    },
    "android": {
      "package": "com.chobor.sundayseeds",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png",
        "backgroundColor": "#173E32"
      }
    },
    "web": {
      "favicon": "./assets/brand/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/logo.png",
          "imageWidth": 144,
          "resizeMode": "contain",
          "backgroundColor": "#FCFAFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
